# Todoist API Key
TODOIST_API_KEY="YOUR_TODOIST_API_KEY"

# Nebius API Key
NEBIUS_API_KEY="YOUR_NEBIUS_API_KEY"

# Nebius model id. Override to switch models without touching code.
# Default: openai/gpt-oss-120b (gpt-oss-20b was retired in April 2026)
NEBIUS_MODEL="openai/gpt-oss-120b"

# AnkiConnect integration
# Override URL if your AnkiConnect runs elsewhere or under a different port
ANKICONNECT_URL="http://localhost:8765"
